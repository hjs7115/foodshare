VITE_API_BASE_URL=http://localhost:8080
VITE_KAKAO_MAP_APP_KEY=

# Backend-only OpenAI ingredient analysis
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

# Local development-only login shortcut
VITE_TEST_LOGIN_EMAIL=
VITE_TEST_LOGIN_PASSWORD=

# FCM service account JSON path (keep the JSON file out of source control).
APP_FIREBASE_ENABLED=true
APP_FIREBASE_SERVICE_ACCOUNT=./secrets/firebase-service-account.json
VITE_FIREBASE_VAPID_KEY=

# Firebase browser configuration (public in the built app; never use a server credential here).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Required backend values; set these privately before running the server.
SPRING_DATASOURCE_PASSWORD=
APP_JWT_SECRET=
APP_ADMIN_TOKEN=
